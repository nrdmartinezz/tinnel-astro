---
import { Image } from 'astro:assets';
import { officeLinks } from '../config/site';
import scallop from '../assets/scalloped-bg-blue.png';

const linkClass =
  'bg-brand-500 hover:bg-brand-600 inline-flex min-h-14 items-center justify-center rounded-[14px] px-8 text-center text-[19px] leading-[1.35] font-semibold text-white uppercase no-underline';
---

<section class="flex justify-center px-6 py-16 md:px-10">
  <div
    class="relative w-full max-w-[52rem] overflow-hidden rounded-[14px] bg-white px-6 pt-10 pb-8 md:px-9 md:pt-12"
  >
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <Image
        src={scallop}
        alt=""
        class="absolute top-0 left-0 h-full w-[123.32%] max-w-none opacity-[0.16]"
        widths={[800, 1400, 2000]}
        sizes="100vw"
      />
    </div>
    <div class="relative flex flex-col items-center gap-3 text-center">
      <h1 class="text-navy-600 w-full text-[2rem] leading-[normal] font-bold md:text-[48px]">
        Thank you for choosing<br class="hidden md:inline" /> HT Complete Family<br
          class="hidden md:inline"
        /> Dentistry!
      </h1>
      <p class="text-[17px] leading-6 text-[#131313]">
        Please note that submitting an appointment request does not confirm your appointment.
        Although you will be prompted to select a preferred date and time, your selection is a
        <strong>request only</strong> and is subject to availability.
      </p>
      <p class="text-[17px] leading-6 text-[#131313]">
        A member of our team will review your request and contact you by text, email, and/or phone
        to confirm your appointment or discuss alternative scheduling options if needed.
      </p>
      <p class="py-4 text-[20px] leading-6 font-bold text-[#131313]">
        Your appointment is not officially scheduled until you have received confirmation from our
        office.
      </p>
      <a href={officeLinks.appointment} class={linkClass} target="_blank" rel="noopener noreferrer">
        Continue to Appointment Request
      </a>
      <p class="text-[17px] leading-6 text-[#131313]">
        We appreciate the opportunity to care for your smile and look forward to hearing from you!
      </p>
    </div>
  </div>
</section>
