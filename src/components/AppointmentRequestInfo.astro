---
import { Image } from 'astro:assets';
import { officeLinks } from '../config/site';
import hero from '../assets/hero.jpg';
import scallop from '../assets/scalloped-bg-blue.png';

const linkClass =
  'bg-brand-500 hover:bg-brand-600 inline-flex min-h-14 items-center justify-center self-start rounded-lg px-6 text-center text-base leading-snug font-semibold text-white uppercase no-underline md:px-8 md:text-lg';
---

<section class="relative z-10 min-h-[34rem] md:min-h-[45rem]">
  <Image
    src={hero}
    alt=""
    class="absolute inset-0 h-full w-full object-cover"
    widths={[800, 1400, 2000]}
    sizes="100vw"
  />
  <div
    class="px-gutter relative z-10 flex min-h-[34rem] items-end pt-10 pb-16 md:min-h-[45rem] md:pt-16"
  >
    <div
      class="relative w-full max-w-[52rem] overflow-hidden rounded-[14px] bg-white px-6 pt-10 pb-8 md:px-9 md:pt-12"
    >
      <div
        class="pointer-events-none absolute inset-0 bg-cover opacity-[0.16]"
        style={`background-image: url('${scallop.src}')`}
        aria-hidden="true"
      >
      </div>
      <div class="relative flex flex-col gap-3">
        <h1 class="text-navy-600 text-4xl font-bold md:text-5xl">
          Thank you for choosing HT Complete Family Dentistry!
        </h1>
        <p class="text-base leading-6 text-[#131313]">
          Please note that submitting an appointment request does not confirm your appointment.
          Although you will be prompted to select a preferred date and time, your selection is a
          <strong>request only</strong> and is subject to availability.
        </p>
        <p class="text-base leading-6 text-[#131313]">
          A member of our team will review your request and contact you by text, email, and/or phone
          to confirm your appointment or discuss alternative scheduling options if needed.
        </p>
        <p class="text-base leading-6 text-[#131313]">
          <strong
            >Your appointment is not officially scheduled until you have received confirmation from
            our office.</strong
          >
        </p>
        <p class="text-base leading-6 text-[#131313]">
          We appreciate the opportunity to care for your smile and look forward to hearing from you!
        </p>
        <a
          href={officeLinks.appointment}
          class={linkClass}
          target="_blank"
          rel="noopener noreferrer"
        >
          Continue to Appointment Request
        </a>
      </div>
    </div>
  </div>
</section>
