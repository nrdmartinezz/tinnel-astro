---
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import aligners from '../../assets/technology.jpg';

const items = [
  {
    title: 'Invisalign',
    body: 'At Harman-Tinnel Complete Family Dentistry, we are proud to offer Invisalign Clear Aligners to our patients! We believe that everyone deserves a healthy smile they love, and we know that aesthetics play a significant role in loving your smile. With the expertise of Dr. Tinnel, Dr. Whitney, and Dr. Garling, Invisalign aligners can transform the aesthetics of your smile, giving you a smile you’ll love for a lifetime.',
  },
  {
    title: 'HT Smile 3D',
    body: 'HT Smile 3D provides a comprehensive view of your teeth and gums, allowing us to detect problems that may be missed with traditional methods. This advanced imaging enables us to create a tailored treatment plan specifically designed for your needs.',
  },
];
---

<section class="relative overflow-hidden py-section">
  <Container layout="row" gap="lg" class="md:items-center">
    <Image
      src={aligners}
      alt="Clear aligners used for orthodontic treatment"
      class="h-[350px] w-full rounded-[10px] object-cover shadow-[0_0_5px_rgba(0,218,255,0.13)] md:w-[416px] md:shrink-0"
      widths={[416, 720]}
      sizes="(min-width: 768px) 416px, 100vw"
    />

    <div class="flex min-w-0 flex-col gap-5 md:flex-1">
      <p class="text-navy-600 text-lg font-bold uppercase">Advanced Technology</p>
      <h2 class="text-brand-500 text-4xl font-bold">Orthodontics of Tomorrow</h2>
      <p>
        At HT Complete Family Dentistry, we are excited to introduce HT Smile 3D, a revolutionary
        tool designed to enhance your dental care. This advanced technology allows us to visualize
        your dental needs with precision, helping to ensure that you receive the best possible
        treatment. By utilizing state-of-the-art imaging techniques, we can identify issues early,
        plan effective treatments, and improve your overall dental health. With HT Smile 3D, you’ll
        experience a seamless blend of comfort and efficiency during your visits.
      </p>

      <div class="flex flex-col">
        {
          items.map((item) => (
            <details class="group border-brand-500 border-b-2">
              <summary class="text-brand-500 flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 px-2.5 py-2.5 text-lg font-bold uppercase">
                {item.title}
                <span class="text-brand-500 text-xl leading-none group-open:hidden" aria-hidden="true">
                  +
                </span>
                <span
                  class="text-brand-500 hidden text-xl leading-none group-open:inline"
                  aria-hidden="true"
                >
                  –
                </span>
              </summary>
              <p class="px-2.5 pb-4">{item.body}</p>
            </details>
          ))
        }
      </div>
    </div>
  </Container>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
