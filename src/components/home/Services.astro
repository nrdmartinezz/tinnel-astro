---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import { officeLinks } from '../../config/site';
import invisalign from '../../assets/invisalign.jpg';
import aesthetics from '../../assets/aesthetics.jpg';
import children from '../../assets/children.jpg';
import whitening from '../../assets/whitening.jpg';
import crowns from '../../assets/crowns.jpg';
import implants from '../../assets/implants.jpg';

const services: { title: string; href: string; image: ImageMetadata; alt: string }[] = [
  {
    title: 'Invisalign Treatments',
    href: '/invisalign/',
    image: invisalign,
    alt: 'Invisalign - Overland Park - Kansas City',
  },
  {
    title: 'Aesthetic Treatments',
    href: '/aesthetics/',
    image: aesthetics,
    alt: 'Aesthetic Treatments - Overland Park - Kansas City',
  },
  {
    title: "Children's Dentistry",
    href: '/childrens-dentistry/',
    image: children,
    alt: "Children's Dentistry - Overland Park - Kansas City",
  },
  {
    title: 'Teeth Whitening',
    href: '/cosmetic-dentistry/teeth-whitening/',
    image: whitening,
    alt: 'Teeth Whitening - Overland Park - Kansas City',
  },
  {
    title: 'Tooth Crowns',
    href: '/general-dentistry/crowns/',
    image: crowns,
    alt: 'Tooth Crown - Overland Park - Kansas City',
  },
  {
    title: 'Dental Implants',
    href: '/general-dentistry/dental-implants/',
    image: implants,
    alt: 'Dental Implants - Overland Park - Kansas City',
  },
];
---

<Section spacing="md">
  <Container gap="lg">
    <div class="grid w-full items-start gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
      <div class="flex flex-col gap-4">
        <p class="text-navy-600 text-sm font-semibold tracking-[0.14em] uppercase">Our Services</p>
        <h2 class="text-brand-500 text-4xl font-semibold">How We Can Help</h2>
        <p>
          At Harman-Tinnel Complete Family Dentistry, we provide comprehensive general and cosmetic
          dentistry to keep your smile healthy and radiant.
        </p>
        <p>
          Our general dentistry services include routine cleanings, exams, and preventive care to
          protect your oral health and catch issues early—keeping your smile in top shape for years
          to come.
        </p>
        <p>
          Want to enhance your smile? Our cosmetic treatments—including teeth whitening, veneers,
          bonding, and full smile makeovers—are personalized to your goals, combining modern
          technology with artistic detail for results that look as good as they feel.
        </p>
        <p>Let’s create a smile you love to share.</p>
        <a
          href={officeLinks.appointment}
          class="bg-brand-500 hover:bg-brand-600 inline-flex min-h-14 w-fit items-center justify-center rounded-lg px-8 text-lg font-bold text-white uppercase no-underline"
          target="_blank"
          rel="noopener noreferrer"
        >
          Get Started Today!
        </a>
      </div>

      <ul class="grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-3">
        {
          services.map((service) => (
            <li>
              <a href={service.href} class="group flex flex-col items-center gap-3 no-underline">
                <Image
                  src={service.image}
                  alt={service.alt}
                  class="size-[125px] rounded-full object-cover"
                  widths={[125, 250]}
                  sizes="125px"
                />
                <span class="text-navy-400 group-hover:text-brand-600 text-center text-lg leading-snug font-bold uppercase">
                  {service.title}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</Section>
