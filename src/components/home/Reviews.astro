---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import { officeLinks } from '../../config/site';

const reviews = [
  {
    name: 'Grace Rogers',
    when: '6 days ago',
    quote:
      'I LOVE Dr. Garling & Jordan!! They are so caring and ensured I was comfortable throughout the morning! They worked me into their schedule and were AMAZING! Kelsey is also fantastic—I have so much anxiety around the dentist and they made me feel great about my visit. 11/10!!',
  },
  {
    name: 'Debbie Williams',
    when: '19 days ago',
    quote:
      'I had a wonderful experience at HT Family Dentistry with Dr. Sarina Tinnel and her team. The front desk staff made me feel welcome from the moment I walked in. Kim, my dental hygienist, gave me a thorough, gentle cleaning that was quick and painless and we had a good conversation too. I also appreciated the careful checkups, including a screening of my mouth and tongue. I highly recommend this practice!!',
  },
  {
    name: 'Its me Just me',
    when: '22 days ago',
    quote: 'They are fairly quick getting you back and are kind and considerate.',
  },
];
---

<Section spacing="md">
  <Container gap="md">
    <div class="flex w-full flex-col items-center gap-2 text-center">
      <p class="text-navy-600 text-sm font-semibold tracking-[0.14em] uppercase">
        Real Patient Reviews
      </p>
      <h2 class="text-brand-500 text-4xl font-semibold">What Our Patients Are Saying</h2>
    </div>

    <div class="w-full" data-carousel>
      <div class="mb-4 flex justify-end gap-2">
        <button
          type="button"
          data-carousel-prev
          class="border-line-base inline-flex size-11 items-center justify-center rounded-full border"
        >
          <span class="sr-only">Previous reviews</span>
          <span aria-hidden="true">‹</span>
        </button>
        <button
          type="button"
          data-carousel-next
          class="border-line-base inline-flex size-11 items-center justify-center rounded-full border"
        >
          <span class="sr-only">Next reviews</span>
          <span aria-hidden="true">›</span>
        </button>
      </div>

      <div
        data-carousel-track
        class="flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth pb-2"
      >
        {
          reviews.map((review) => (
            <article class="border-line-base flex w-[min(100%,22rem)] shrink-0 snap-start flex-col gap-3 rounded-2xl border p-5 md:w-[calc(50%-0.5rem)] lg:w-[calc(33.333%-0.75rem)]">
              <p class="text-brand-500" aria-label="5 out of 5 stars">
                ★★★★★
              </p>
              <p class="text-ink-base">{review.quote}</p>
              <p class="text-navy-600 mt-auto font-semibold">
                {review.name}
                <span class="text-ink-muted block text-sm font-normal">{review.when}</span>
              </p>
            </article>
          ))
        }
      </div>
    </div>

    <a
      href={officeLinks.maps}
      class="text-brand-700 font-semibold"
      target="_blank"
      rel="noopener noreferrer"
    >
      View reviews on Google
    </a>
  </Container>
</Section>
