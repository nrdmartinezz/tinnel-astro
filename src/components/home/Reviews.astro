---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import { officeLinks, site } from '../../config/site';

const writeReviewHref = site.googlePlaceId
  ? `https://search.google.com/local/writereview?placeid=${encodeURIComponent(site.googlePlaceId)}`
  : officeLinks.maps;
---

<Section spacing="md" data-reviews>
  <Container gap="md">
    <div class="flex w-full flex-col items-center gap-2 text-center">
      <p class="text-navy-600 text-sm font-semibold tracking-[0.14em] uppercase">
        Real Patient Reviews
      </p>
      <h2 class="text-brand-500 text-4xl font-semibold">What Our Patients Are Saying</h2>
      <p class="text-ink-muted text-sm" data-reviews-summary hidden></p>
    </div>

    <div class="w-full min-w-0" data-carousel hidden>
      <div class="mb-4 flex justify-end gap-2">
        <button
          type="button"
          data-carousel-prev
          class="border-line-base inline-flex size-11 items-center justify-center rounded-full border"
        >
          <span class="sr-only">Previous reviews</span>
          <span aria-hidden="true">‹</span>
        </button>
        <button
          type="button"
          data-carousel-next
          class="border-line-base inline-flex size-11 items-center justify-center rounded-full border"
        >
          <span class="sr-only">Next reviews</span>
          <span aria-hidden="true">›</span>
        </button>
      </div>

      <div
        data-carousel-track
        class="flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth pb-2"
      >
      </div>
    </div>

    <div class="flex w-full flex-wrap items-center justify-between gap-x-6 gap-y-2">
      <p class="text-ink-muted flex items-center gap-2 text-sm" data-reviews-attribution hidden>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="size-5" aria-hidden="true">
          <path
            fill="#FFC107"
            d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 8 3.1l5.7-5.7C34.2 6.1 29.4 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.5z"
          ></path>
          <path
            fill="#FF3D00"
            d="M6.3 14.7l6.6 4.8C14.7 16 19 12 24 12c3.1 0 5.8 1.2 8 3.1l5.7-5.7C34.2 6.1 29.4 4 24 4 16.3 4 9.6 8.3 6.3 14.7z"
          ></path>
          <path
            fill="#4CAF50"
            d="M24 44c5.2 0 10-2 13.6-5.2l-6.3-5.3C29.3 35.1 26.8 36 24 36c-5.3 0-9.7-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"
          ></path>
          <path
            fill="#1976D2"
            d="M43.6 20.5H42V20H24v8h11.3c-1.1 3.2-3.5 5.7-6.6 7.1l.1.1 6.3 5.3C36.9 41.6 44 36 44 24c0-1.3-.1-2.7-.4-3.5z"
          ></path>
        </svg>
        Reviews from Google
      </p>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <a
          href={officeLinks.maps}
          class="text-brand-700 font-semibold"
          target="_blank"
          rel="noopener noreferrer"
        >
          Read reviews on Google
        </a>
        <a
          href={writeReviewHref}
          class="text-brand-700 font-semibold"
          target="_blank"
          rel="noopener noreferrer"
        >
          Add a review
        </a>
      </div>
    </div>
  </Container>
</Section>

<script>
  import { initCarousels } from '../../scripts/carousels';

  type ReviewCard = {
    author?: unknown;
    authorUrl?: unknown;
    rating?: unknown;
    text?: unknown;
    relativeTime?: unknown;
  };

  const safeHttps = (value: unknown): string => {
    if (typeof value !== 'string' || value === '') return '';
    try {
      const url = new URL(value);
      return url.protocol === 'https:' ? url.href : '';
    } catch {
      return '';
    }
  };

  const FORMAT_TAGS = new Set(['B', 'STRONG', 'I', 'EM', 'BR']);
  const DROPPED_TAGS = new Set(['SCRIPT', 'STYLE', 'NOSCRIPT', 'IFRAME', 'OBJECT', 'EMBED']);

  /** Google review text can include simple HTML. Keep bold, italic, and breaks only. */
  const appendFormatted = (parent: HTMLElement, source: string) => {
    const withBreaks = source.replace(/\r\n|\r|\n/g, '<br>');
    const parsed = new DOMParser().parseFromString(withBreaks, 'text/html');

    const walk = (node: Node, target: HTMLElement) => {
      for (const child of node.childNodes) {
        if (child.nodeType === Node.TEXT_NODE) {
          target.append(document.createTextNode(child.textContent ?? ''));
          continue;
        }
        if (child.nodeType !== Node.ELEMENT_NODE) continue;

        const element = child as HTMLElement;
        if (DROPPED_TAGS.has(element.tagName)) continue;
        if (!FORMAT_TAGS.has(element.tagName)) {
          walk(element, target);
          continue;
        }
        if (element.tagName === 'BR') {
          target.append(document.createElement('br'));
          continue;
        }

        const safe = document.createElement(element.tagName.toLowerCase());
        walk(element, safe);
        target.append(safe);
      }
    };

    walk(parsed.body, parent);
  };

  const renderCard = (review: ReviewCard): HTMLElement => {
    const rating = typeof review.rating === 'number' ? Math.round(review.rating) : 0;
    const stars = Math.min(5, Math.max(0, rating));
    const article = document.createElement('article');
    article.className =
      'border-line-base flex w-[min(100%,22rem)] shrink-0 snap-start flex-col gap-3 rounded-2xl border p-5 md:w-[calc(50%-0.5rem)] lg:w-[calc(33.333%-0.75rem)]';

    const starLine = document.createElement('p');
    starLine.className = 'text-brand-500';
    starLine.setAttribute('aria-label', `${stars} out of 5 stars`);
    starLine.textContent = '★'.repeat(stars) + '☆'.repeat(5 - stars);

    const quote = document.createElement('p');
    quote.className = 'text-ink-base';
    appendFormatted(quote, typeof review.text === 'string' ? review.text : '');

    const byline = document.createElement('p');
    byline.className = 'text-navy-600 mt-auto font-semibold';

    const author = typeof review.author === 'string' ? review.author : '';
    const authorUrl = safeHttps(review.authorUrl);
    if (authorUrl) {
      const link = document.createElement('a');
      link.href = authorUrl;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.className = 'hover:underline';
      link.draggable = false;
      link.textContent = author;
      byline.append(link);
    } else {
      byline.append(document.createTextNode(author));
    }

    const when = document.createElement('span');
    when.className = 'text-ink-muted block text-sm font-normal';
    when.textContent = typeof review.relativeTime === 'string' ? review.relativeTime : '';
    byline.append(when);

    article.append(starLine, quote, byline);
    return article;
  };

  const root = document.querySelector<HTMLElement>('[data-reviews]');
  const track = root?.querySelector<HTMLElement>('[data-carousel-track]');
  const carousel = root?.querySelector<HTMLElement>('[data-carousel]');
  const summary = root?.querySelector<HTMLElement>('[data-reviews-summary]');
  const attribution = root?.querySelector<HTMLElement>('[data-reviews-attribution]');

  if (root && track && carousel) {
    fetch('/api/reviews.php', { headers: { Accept: 'application/json' } })
      .then((response) => {
        if (!response.ok) throw new Error('reviews unavailable');
        return response.json();
      })
      .then((data: { rating?: unknown; reviewCount?: unknown; reviews?: unknown }) => {
        const reviews = Array.isArray(data.reviews) ? (data.reviews as ReviewCard[]) : [];
        const cards = reviews.filter(
          (review) => typeof review.text === 'string' && review.text !== '',
        );
        if (cards.length === 0) return;

        for (const review of cards) track.append(renderCard(review));
        carousel.hidden = false;

        if (summary && typeof data.rating === 'number') {
          const count = typeof data.reviewCount === 'number' ? data.reviewCount : cards.length;
          summary.textContent = `${data.rating.toFixed(1)} out of 5 · ${count.toLocaleString()} Google reviews`;
          summary.hidden = false;
        }

        if (attribution) attribution.hidden = false;
        initCarousels();
      })
      .catch(() => {
        // The Google links below stay available when the feed is not configured yet.
      });
  }
</script>
