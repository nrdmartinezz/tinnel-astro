---
import Container from '../ui/Container.astro';
import { site, officeLinks } from '../../config/site';

const buttonClass =
  'bg-navy-600 hover:bg-navy-700 inline-flex min-h-12 flex-1 items-center justify-center rounded-md px-4 text-lg font-bold text-white uppercase no-underline';
---

<section class="bg-brand-500">
  <Container layout="row" gap="md" class="items-center justify-between py-16">
    <h2 class="text-navy-600 max-w-xl text-4xl leading-tight font-bold">
      Ready for a happier, healthier smile? Schedule your appointment today!
    </h2>
    <div class="flex w-full max-w-xl flex-col gap-5 sm:flex-row">
      <a href={`tel:${site.business.phoneHref}`} class={buttonClass}>
        Call Us: {site.business.phone}
      </a>
      <a
        href={officeLinks.appointment}
        class={buttonClass}
        target="_blank"
        rel="noopener noreferrer"
      >
        Schedule Online
      </a>
    </div>
  </Container>
</section>
