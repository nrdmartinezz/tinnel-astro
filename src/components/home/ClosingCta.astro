---
import Container from '../ui/Container.astro';
import { site, officeLinks } from '../../config/site';
---

<section class="bg-brand-50">
  <Container class="py-section items-center text-center" align="center" gap="md">
    <h2 class="text-navy-600 max-w-3xl text-4xl font-semibold text-balance">
      Ready for a happier, healthier smile? Schedule your appointment today!
    </h2>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        href={`tel:${site.business.phoneHref}`}
        class="border-navy-600 text-navy-600 hover:bg-navy-600 inline-flex min-h-12 items-center justify-center rounded-lg border px-6 font-semibold no-underline hover:text-white"
      >
        Call Us: {site.business.phone}
      </a>
      <a
        href={officeLinks.appointment}
        class="bg-navy-600 hover:bg-navy-700 inline-flex min-h-12 items-center justify-center rounded-lg px-6 font-semibold text-white no-underline"
        target="_blank"
        rel="noopener noreferrer"
      >
        Schedule Online
      </a>
    </div>
  </Container>
</section>
