---
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import { site, officeLinks } from '../../config/site';
import { Icon } from 'astro-icon/components';
import wash from '../../assets/scalloped-bg-blue.png';
import photoOne from '../../assets/location-1.jpg';
import photoTwo from '../../assets/location-2.jpg';
import photoThree from '../../assets/location-3.jpg';

const photos = [
  { src: photoOne, alt: 'Treatment room at the Overland Park office' },
  { src: photoTwo, alt: 'Reception at the Overland Park office' },
  { src: photoThree, alt: 'Exterior of the Overland Park office' },
];
---

<section class="py-section relative overflow-hidden">
  <Image
    src={wash}
    alt=""
    class="absolute inset-0 h-full w-full object-cover"
    widths={[720, 1440]}
    sizes="100vw"
  />
  <div class="absolute inset-0 bg-white/85" aria-hidden="true"></div>

  <Container layout="row" gap="lg" class="relative md:items-center">
    <div class="flex w-full flex-col gap-5 md:w-[26rem] md:shrink-0">
      {
        photos.map((photo) => (
          <Image
            src={photo.src}
            alt={photo.alt}
            class="h-25 w-full rounded-[5px] object-cover"
            widths={[416, 832]}
            sizes="(min-width: 768px) 416px, 100vw"
          />
        ))
      }
    </div>

    <div class="flex min-w-0 flex-col gap-5">
      <p class="text-navy-600 text-lg font-bold uppercase">Overland Park, Kansas</p>
      <h2 class="text-brand-500 text-4xl font-bold">Brand New Location!</h2>
      <div class="flex flex-col gap-4">
        <p>
          We’re excited to welcome you to our newest location in <strong>Overland Park, KS</strong
          >—bringing the trusted care of Harman-Tinnel Complete Family Dentistry to a growing
          community of families and professionals. Conveniently located and designed with your
          comfort in mind, our Overland Park office offers the same full range of
          <strong>general and cosmetic dentistry services</strong> that our patients know and love.
        </p>
        <p>
          Whether you’re looking for routine cleanings, preventive care, or a complete smile
          makeover, our experienced team is here to help you achieve your oral health goals in a
          warm, modern setting.
        </p>
        <p>
          Schedule your appointment today and experience the Harman-Tinnel difference close to home.
        </p>
      </div>
      <a
        href={officeLinks.maps}
        target="_blank"
        rel="noopener noreferrer"
        class="text-navy-600 inline-flex items-start gap-3 no-underline"
      >
        <Icon
          name="lucide:map-pin"
          class="text-brand-500 mt-1 size-6 shrink-0"
          aria-hidden="true"
        />
        <span class="font-semibold">
          {site.business.address.street}<br />
          {site.business.address.locality}, {site.business.address.region}{' '}
          {site.business.address.postalCode}
        </span>
      </a>
    </div>
  </Container>
</section>
