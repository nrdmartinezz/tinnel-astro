---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Container from '../ui/Container.astro';
import ada from '../../assets/ada.png';
import agd from '../../assets/agd.png';
import asap from '../../assets/asap.png';
import cerec from '../../assets/cerec.png';
import kda from '../../assets/kda.png';
import spear from '../../assets/spear.png';

const logos: { src: ImageMetadata; alt: string }[] = [
  { src: cerec, alt: 'Cerec Doctors' },
  { src: kda, alt: 'Kansas Dental Association' },
  { src: spear, alt: 'Spear Study Club' },
  { src: ada, alt: 'American Dental Association' },
  { src: agd, alt: 'Academy of General Dentistry' },
  { src: asap, alt: 'ASAP Pathway' },
];
---

<section class="py-10" aria-label="Professional affiliations">
  <Container>
    <ul class="flex w-full flex-wrap items-center justify-between gap-8">
      {
        logos.map((logo) => (
          <li>
            <Image
              src={logo.src}
              alt={logo.alt}
              class="h-12 w-auto object-contain"
              widths={[120, 220]}
              sizes="140px"
            />
          </li>
        ))
      }
    </ul>
  </Container>
</section>
