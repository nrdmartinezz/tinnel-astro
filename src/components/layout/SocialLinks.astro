---
import { Icon } from 'astro-icon/components';
import { site, officeLinks } from '../../config/site';

const links = [
  { label: 'Facebook', href: site.social.facebook, icon: 'lucide:facebook' },
  { label: 'Google', href: site.social.google, icon: 'google' },
  { label: 'X', href: site.social.x, icon: 'x' },
  { label: 'YouTube', href: site.social.youtube, icon: 'lucide:youtube' },
  { label: 'Map', href: officeLinks.maps, icon: 'lucide:map-pin' },
].filter((link): link is { label: string; href: string; icon: string } => Boolean(link.href));
---

<ul class="flex flex-wrap gap-3">
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-brand-500 hover:bg-brand-600 inline-flex size-11 items-center justify-center rounded-md text-white no-underline"
        >
          <span class="sr-only">{link.label}</span>
          {link.icon === 'google' ? (
            <span class="text-lg leading-none font-bold" aria-hidden="true">
              G
            </span>
          ) : link.icon === 'x' ? (
            <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true" fill="currentColor">
              <path d="M14.7 10.3 22.4 1.5h-1.8l-6.7 7.6L8.4 1.5H1.6l8.1 11.5L1.6 22.5h1.8l7.1-8.1 5.7 8.1h6.8l-8.3-12.2Zm-2.5 2.8-.8-1.2L4.2 2.9h2.8l5.3 7.5.8 1.2 6.9 9.8h-2.8l-5-7.3Z" />
            </svg>
          ) : (
            <Icon name={link.icon} class="size-5" aria-hidden="true" />
          )}
        </a>
      </li>
    ))
  }
</ul>
