---
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import SocialLinks from './SocialLinks.astro';
import { navigation } from '../../config/navigation';
import { site, officeLinks } from '../../config/site';
import { Icon } from 'astro-icon/components';
import logo from '../../assets/logo.png';

const year = new Date().getFullYear();
---

<Section as="footer" background="base" spacing="md" class="border-line-base border-t">
  <Container gap="lg">
    <div class="flex w-full flex-col gap-4">
      <a href="/" class="inline-flex no-underline">
        <Image
          src={logo}
          alt="HT Complete Family Dentistry — Sarina Harman-Tinnel, D.D.S."
          class="h-16 w-auto"
          densities={[1, 2]}
        />
      </a>
      <p class="text-ink-base max-w-xl">
        Proudly serving the communities of Lenexa, Overland Park, Leawood, and Kansas City and
        surrounding areas.
      </p>
      <SocialLinks />
    </div>

    <div class="grid w-full gap-10 md:grid-cols-3">
      {
        navigation.footer.map((group) => (
          <nav aria-label={group.heading} class="flex flex-col gap-3">
            <h2 class="text-navy-400 text-base font-semibold">{group.heading}</h2>
            <ul class="flex flex-col gap-1">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="hover:text-brand-600 inline-flex min-h-11 items-center gap-2 no-underline"
                  >
                    <span class="bg-brand-500 size-2 shrink-0 rounded-full" aria-hidden="true" />
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="flex flex-col gap-3">
        <h2 class="text-navy-400 text-base font-semibold">Contact Us</h2>
        <ul class="flex flex-col gap-1">
          <li>
            <a
              href={`tel:${site.business.phoneHref}`}
              class="hover:text-brand-600 inline-flex min-h-11 items-center gap-2 no-underline"
            >
              <Icon name="lucide:phone" class="text-brand-500 size-4" aria-hidden="true" />
              {site.business.phone}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${site.business.email}`}
              class="hover:text-brand-600 inline-flex min-h-11 items-center gap-2 no-underline"
            >
              <Icon name="lucide:mail" class="text-brand-500 size-4" aria-hidden="true" />
              {site.business.email}
            </a>
          </li>
          <li>
            <a
              href={officeLinks.maps}
              class="hover:text-brand-600 inline-flex min-h-11 items-start gap-2 py-2 no-underline"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon
                name="lucide:map-pin"
                class="text-brand-500 mt-1 size-4 shrink-0"
                aria-hidden="true"
              />
              <span>
                {site.business.address.street}<br />
                {site.business.address.locality}, {site.business.address.region}{' '}
                {site.business.address.postalCode}
              </span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="border-line-base flex w-full flex-col gap-3 border-t pt-6 text-sm md:flex-row md:items-center md:justify-between"
    >
      <p>&copy; {year} {site.legalName}. All rights reserved.</p>
      <a
        href={officeLinks.npg}
        class="hover:text-brand-600 no-underline"
        target="_blank"
        rel="noopener noreferrer"
      >
        Orthodontic Marketing Consultants New Patient Group
      </a>
    </div>
  </Container>
</Section>
