---
/**
 * Practice header: logo, phone, hours, bill pay, request appointment, and the
 * menu button. The menu itself is MobileNav, open on every breakpoint.
 */
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import MobileNav from './MobileNav.astro';
import { site, officeLinks } from '../../config/site';
import { Icon } from 'astro-icon/components';
import logo from '../../assets/logo.png';

export type HeaderSticky = 'static' | 'sticky' | 'shrink' | 'hide-on-scroll';

interface Props {
  sticky?: HeaderSticky;
}

const { sticky = 'sticky' } = Astro.props;

const currentPath = Astro.url.pathname;
const positioned = sticky !== 'static';

const ctaClass =
  'inline-flex min-h-11 items-center justify-center rounded-lg px-4 text-sm font-semibold tracking-wide text-white uppercase no-underline';
---

<header
  data-sticky={sticky}
  class:list={[
    'group/header border-line-base bg-surface-base z-50 w-full border-b shadow-sm',
    positioned ? 'sticky top-0' : 'relative',
  ]}
>
  <Container as="div" layout="bar" gap="none" class="justify-between gap-4 py-3">
    <a href="/" class="shrink-0 no-underline">
      <Image
        src={logo}
        alt="HT Complete Family Dentistry — Sarina Harman-Tinnel, D.D.S."
        class="h-14 w-auto max-md:h-12"
        densities={[1, 2]}
      />
    </a>

    <div class="flex items-center gap-3">
      <div class="hidden items-center gap-4 lg:flex">
        <a
          href={`tel:${site.business.phoneHref}`}
          class="text-navy-400 flex flex-col items-start leading-tight no-underline"
        >
          <span class="inline-flex items-center gap-2 text-lg font-semibold">
            <Icon name="lucide:phone" class="text-brand-500 size-5" aria-hidden="true" />
            {site.business.phone}
          </span>
          <span class="text-navy-400 pl-7 text-xs font-medium tracking-wide">
            HOURS: 8:00am – 5:00pm
          </span>
        </a>

        <a
          href={officeLinks.billPay}
          class={`${ctaClass} bg-brand-500 hover:bg-brand-600`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Online Bill Pay
        </a>
        <a
          href={officeLinks.appointment}
          class={`${ctaClass} bg-navy-600 hover:bg-navy-700`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Request Appointment
        </a>
      </div>

      <a
        href={`tel:${site.business.phoneHref}`}
        class="text-navy-600 inline-flex size-11 items-center justify-center no-underline lg:hidden"
      >
        <span class="sr-only">Call {site.business.phone}</span>
        <Icon name="lucide:phone" class="text-brand-500 size-6" aria-hidden="true" />
      </a>

      <MobileNav currentPath={currentPath} />
    </div>
  </Container>
</header>

<style>
  header {
    transition:
      transform 200ms ease,
      padding 150ms ease;
  }

  header[data-hidden='true'] {
    transform: translateY(-100%);
  }

  header[data-scrolled='true'] {
    box-shadow: var(--shadow-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    header {
      transition: none;
    }

    header[data-hidden='true'] {
      transform: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('header[data-sticky]');

  if (header) {
    const mode = header.dataset.sticky;

    if (mode === 'shrink' || mode === 'hide-on-scroll') {
      let lastY = window.scrollY;
      let ticking = false;

      const update = () => {
        const y = window.scrollY;
        header.dataset.scrolled = String(y > 8);

        if (mode === 'hide-on-scroll') {
          const navOpen =
            document.querySelector('#nav-toggle')?.getAttribute('aria-expanded') === 'true';
          header.dataset.hidden = String(!navOpen && y > lastY && y > 120);
        }

        lastY = y;
        ticking = false;
      };

      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true },
      );

      update();
    }
  }
</script>
