---
/**
 * Site menu. The live header uses a Menu button at every width, so this drawer
 * is not limited to small screens.
 */
import Container from '../ui/Container.astro';
import { navigation } from '../../config/navigation';
import { officeLinks } from '../../config/site';
import { Icon } from 'astro-icon/components';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : href.startsWith('/') && currentPath.startsWith(href);

const linkClass =
  'flex min-h-12 items-center gap-3 rounded-md px-2 text-base no-underline text-ink-base aria-[current=page]:text-ink-brand aria-[current=page]:font-medium';

const externalAttrs = (link: { external?: boolean }) =>
  link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<button
  type="button"
  id="nav-toggle"
  aria-expanded="false"
  aria-controls="mobile-nav"
  class="text-navy-400 inline-flex min-h-11 shrink-0 items-center gap-2 rounded-md px-1 text-lg font-bold whitespace-nowrap uppercase hover:bg-neutral-100 xl:gap-4 xl:px-2"
>
  <Icon name="lucide:menu" class="size-6" aria-hidden="true" />
  Menu
</button>

<div
  id="mobile-nav"
  hidden
  class="bg-surface-base fixed inset-0 top-(--header-h) z-40 overflow-y-auto overscroll-contain"
>
  <Container
    as="nav"
    gap="none"
    aria-label="Menu"
    class="py-4 pb-[max(2rem,env(safe-area-inset-bottom))]"
  >
    <div class="mb-4 flex flex-col gap-3 lg:hidden">
      <a
        href={officeLinks.billPay}
        class="bg-brand-500 inline-flex min-h-11 items-center justify-center rounded-lg px-4 text-sm font-semibold tracking-wide text-white uppercase no-underline"
        target="_blank"
        rel="noopener noreferrer"
      >
        Online Bill Pay
      </a>
      <a
        href={officeLinks.appointment}
        class="bg-navy-600 inline-flex min-h-11 items-center justify-center rounded-lg px-4 text-sm font-semibold tracking-wide text-white uppercase no-underline"
        target="_blank"
        rel="noopener noreferrer"
      >
        Request Appointment
      </a>
    </div>

    <ul class="flex w-full flex-col">
      {
        navigation.primary.map((item, index) => {
          const sublinks =
            item.panel?.kind === 'mega'
              ? item.panel.columns.flatMap((column) => column.links)
              : (item.panel?.links ?? []);

          if (sublinks.length === 0) {
            return (
              <li class="border-line-base border-b">
                <a
                  href={item.href ?? '#'}
                  aria-current={isCurrent(item.href ?? '') ? 'page' : undefined}
                  class={linkClass}
                  {...externalAttrs(item)}
                >
                  {item.label}
                </a>
              </li>
            );
          }

          const panelId = `mobile-panel-${index}`;

          return (
            <li class="border-line-base border-b">
              <div class="flex items-center">
                {item.href ? (
                  <a
                    href={item.href}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                    class={`${linkClass} flex-1`}
                    {...externalAttrs(item)}
                  >
                    {item.label}
                  </a>
                ) : (
                  <span class={`${linkClass} flex-1 font-semibold`}>{item.label}</span>
                )}

                <button
                  type="button"
                  class="mobile-accordion inline-flex size-12 shrink-0 items-center justify-center rounded-md hover:bg-neutral-100"
                  aria-expanded="false"
                  aria-controls={panelId}
                >
                  <span class="sr-only">Show {item.label} links</span>
                  <Icon
                    name="lucide:chevron-down"
                    class="size-5 transition-transform"
                    aria-hidden="true"
                  />
                </button>
              </div>

              <ul
                id={panelId}
                hidden
                class="border-line-base mb-2 ml-2 flex flex-col border-l pl-3"
              >
                {sublinks.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      aria-current={isCurrent(link.href) ? 'page' : undefined}
                      class={linkClass}
                      {...externalAttrs(link)}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          );
        })
      }
    </ul>
  </Container>
</div>

<style>
  #mobile-nav {
    --header-h: 4.5rem;
  }

  .mobile-accordion[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('#nav-toggle');
  const drawer = document.querySelector<HTMLElement>('#mobile-nav');
  const header = document.querySelector<HTMLElement>('header[data-sticky]');

  if (toggle && drawer) {
    const outside = Array.from(document.body.children).filter(
      (el) => el !== header && el !== drawer,
    ) as HTMLElement[];

    const setDrawer = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      drawer.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';

      for (const el of outside) {
        if (open) el.setAttribute('inert', '');
        else el.removeAttribute('inert');
      }

      if (open) {
        drawer.style.setProperty('--header-h', `${header?.offsetHeight ?? 0}px`);
        drawer.querySelector<HTMLAnchorElement>('a')?.focus();
      } else {
        toggle.focus();
      }
    };

    toggle.addEventListener('click', () =>
      setDrawer(toggle.getAttribute('aria-expanded') !== 'true'),
    );

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true')
        setDrawer(false);
    });
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('.mobile-accordion')) {
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') === 'true';
      const panel = document.getElementById(button.getAttribute('aria-controls') ?? '');
      button.setAttribute('aria-expanded', String(!open));
      if (panel) panel.hidden = open;
    });
  }
</script>
