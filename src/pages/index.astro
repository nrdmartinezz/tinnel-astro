---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import Doctor from '../components/home/Doctor.astro';
import Location from '../components/home/Location.astro';
import Services from '../components/home/Services.astro';
import Technology from '../components/home/Technology.astro';
import Reviews from '../components/home/Reviews.astro';
import Team from '../components/home/Team.astro';
import LogoStrip from '../components/home/LogoStrip.astro';
import ContactBand from '../components/home/ContactBand.astro';
import ClosingCta from '../components/home/ClosingCta.astro';

const title =
  'HT Complete Family Dentistry Providing Pediatric, Invisalign, & Cosmetic Dentistry in Overland Park';
---

<BaseLayout title={title} titleExact>
  <HomeHero />
  <Doctor />
  <Location />
  <Services />
  <Technology />
  <Reviews />
  <Team />
  <LogoStrip />
  <ContactBand />
  <ClosingCta />
</BaseLayout>

<script>
  import { initCarousels } from '../scripts/carousels';

  initCarousels();
</script>
